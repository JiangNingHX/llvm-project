# CHECK: split-unit='a.cpp'
# CHECK: live-range [0x{{[0-9a-f]+}}, 0x{{[0-9a-f]+}}) section=
# CHECK: addressable-subprograms=1
# CHECK: live-roots=1
# CHECK: retained-dies=4
# CHECK: live-subprograms=1
# CHECK: sample-subprogram='_Z1ai'
# CHECK: sample-range [0x{{[0-9a-f]+}}, 0x{{[0-9a-f]+}}) section=
# CHECK: retained-package-dies=4

