# CHECK: rewrite-section DW_SECT_LOC: contributions=1, total-length=0x{{[0-9a-f]+}}
# CHECK: rewrite-input-section '.debug_loc.dwo': size=0x{{[0-9a-f]+}}, materialized=0x{{[0-9a-f]+}}
# CHECK: rewrite-output-section '.debug_loc.dwo': size=0x{{[0-9a-f]+}}
