# CHECK: rewrite-input-section '.debug_info.dwo': size=0x{{[0-9a-f]+}}, materialized=0x{{[0-9a-f]+}}
# CHECK: rewrite-output-section '.debug_info.dwo': size=0x{{[0-9a-f]+}}
