--- |
  @tls = thread_local(localexec) global [32 x i8] zeroinitializer, align 32

  define i64 @fold_tls_with_debug() !dbg !4 {
    ret i64 0
  }

  !llvm.dbg.cu = !{!0}
  !llvm.module.flags = !{!3}

  !0 = distinct !DICompileUnit(language: DW_LANG_C, file: !1, producer: "llvm",
                               isOptimized: true, runtimeVersion: 0,
