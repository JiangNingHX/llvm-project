---
name:            fold_tls_with_debug
tracksRegLiveness: true
body:             |
  bb.0:
    ; The low relocation cannot be represented after ADDlowTLS is removed, so
    ; invalidate its debug users instead of describing the high-part address.
    ; CHECK-LABEL: name: fold_tls_with_debug
    ; CHECK: [[DEF:%[0-9]+]]:gpr64sp = IMPLICIT_DEF
    ; CHECK-NEXT: DBG_VALUE $noreg, $noreg, !7, !DIExpression(), debug-location !DILocation(line: 1, column: 1, scope: !4)
    ; CHECK-NEXT: [[LDRXui:%[0-9]+]]:gpr64 = LDRXui [[DEF]], target-flags(aarch64-pageoff, aarch64-nc, aarch64-tls) @tls + 8
    ; CHECK-NEXT: $x0 = COPY [[LDRXui]]
    ; CHECK-NEXT: RET_ReallyLR implicit $x0
    %0:gpr64sp = IMPLICIT_DEF
    %1:gpr64sp = ADDlowTLS %0, target-flags(aarch64-pageoff, aarch64-nc, aarch64-tls) @tls
    DBG_VALUE %1, $noreg, !7, !DIExpression(), debug-location !9
    %2:gpr64 = LDRXui %1, 1
    $x0 = COPY %2
    RET_ReallyLR implicit $x0
