                              line: 1, type: !5, scopeLine: 1,
                              spFlags: DISPFlagDefinition | DISPFlagOptimized,
                              unit: !0, retainedNodes: !6)
  !5 = !DISubroutineType(types: !2)
  !6 = !{!7}
